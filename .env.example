# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.
# 로컬 DB는 compose.yaml 이 자동으로 띄우므로 datasource 설정이 필요 없다.

# 프론트 오리진. CORS 허용과 OAuth 콜백 후 리다이렉트 대상으로 함께 쓴다.
FRONTEND_ORIGIN=http://localhost:3000

# 카카오 개발자 콘솔 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao

# HS256 서명 키. 최소 256bit(32자) 이상.
JWT_SECRET=

# Refresh Token 쿠키 도메인. 로컬은 비워 둔다.
COOKIE_DOMAIN=

# 운영에서만 설정한다. Railway 의 Postgres 연결 정보를 JDBC 형식으로 넣는다.
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:port/db
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
